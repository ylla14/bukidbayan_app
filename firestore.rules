rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is the owner
    function isOwner(ownerId) {
      return isAuthenticated() && request.auth.uid == ownerId;
    }

    function isCampaignOwnerFromData(data) {
      return isAuthenticated() && (
        (data.creatorUid != null && data.creatorUid == request.auth.uid) ||
        (data.creatorEmail != null &&
          request.auth.token.email != null &&
          data.creatorEmail == request.auth.token.email)
      );
    }

    function campaignDoc(campaignId) {
      return get(/databases/$(database)/documents/campaigns/$(campaignId));
    }

    // Equipment collection rules
    match /equipment/{equipmentId} {
      // Anyone can read available equipment (for browsing)
      allow read: if resource.data.isAvailable == true;

      // Allow owner to read their own equipment even if not available
      allow read: if isOwner(resource.data.ownerId);

      // Only authenticated users can create equipment
      // Ensure the ownerId matches the authenticated user
      allow create: if isAuthenticated()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.keys().hasAll([
                      'name',
                      'description',
                      'power',
                      'condition',
                      'price',
                      'rentalUnit',
                      'ownerId'
                    ]);

      // Only owner can update their equipment
      // Prevent changing ownerId
      allow update: if isOwner(resource.data.ownerId)
                    && request.resource.data.ownerId == resource.data.ownerId;

      // Only owner can delete their equipment
      allow delete: if isOwner(resource.data.ownerId);
    }

    // Bookings collection rules
    match /bookings/{bookingId} {
      // Users can read bookings they're involved in (as renter or owner)
      allow read: if isAuthenticated()
                  && (resource.data.renterId == request.auth.uid
                      || resource.data.ownerId == request.auth.uid);

      // Authenticated users can create bookings as renters
      // Ensure the renterId matches the authenticated user
      allow create: if isAuthenticated()
                    && request.resource.data.renterId == request.auth.uid
                    && request.resource.data.keys().hasAll([
                      'equipmentId',
                      'ownerId',
                      'renterId',
                      'startDate',
                      'endDate',
                      'totalPrice'
                    ]);

      // Both renter and owner can update booking
      // Typically for status changes (confirm, cancel, complete)
      allow update: if isAuthenticated()
                    && (resource.data.renterId == request.auth.uid
                        || resource.data.ownerId == request.auth.uid);

      // Only renter can delete pending bookings
      allow delete: if isAuthenticated()
                    && resource.data.renterId == request.auth.uid
                    && resource.data.status == 'pending';
    }

    // rentRequests collection rules
    match /rentRequests/{requestId} {
      // Any authenticated user can read all requests (needed for global weather check)
      allow read: if isAuthenticated();

      // Only the renter can create a request
      allow create: if isAuthenticated()
                    && request.resource.data.renterId == request.auth.uid;

      // Renter or owner can update any field;
      // any authenticated user may update ONLY weather-flag fields
      // (required so any client's app open can run the global weather check)
      allow update: if isAuthenticated() && (
        resource.data.renterId == request.auth.uid
        || resource.data.ownerId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['weatherFlag', 'weatherFlagDates', 'weatherFlagUpdatedAt'])
      );

      // Only renter can delete a pending request
      allow delete: if isAuthenticated()
                    && resource.data.renterId == request.auth.uid
                    && resource.data.status == 'pending';
    }

    // Per-user in-app notifications
    match /notifications/{userId}/items/{notifId} {
      // Only the notification owner can read, mark-as-read, or delete
      allow read, update, delete: if isOwner(userId);

      // Any authenticated user can write notifications (weather alerts need this)
      allow create: if isAuthenticated();
    }

    // Shared weather forecast cache (written by whichever client runs the check first)
    match /system/weatherCache {
      allow read, write: if isAuthenticated();
    }

    // Users collection rules
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId);

      // Users can update their own profile
      // Prevent changing critical fields like createdAt
      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                      .hasAny(['createdAt']);

      // Users create their own document during sign-up (signUp() calls .set())
      allow create: if isOwner(userId);

      // Users cannot delete their own profile (use Cloud Functions)
      allow delete: if false;
    }

    match /campaigns/{campaignId} {
      allow read: if resource.data.status != 'draft'
                  || isCampaignOwnerFromData(resource.data);

      allow create: if isAuthenticated()
                    && request.resource.data.creatorUid == request.auth.uid
                    && request.resource.data.pledgedAmount == 0
                    && request.resource.data.backersCount == 0;

      allow update: if isCampaignOwnerFromData(resource.data)
                    && request.resource.data.creatorUid == resource.data.creatorUid
                    && request.resource.data.pledgedAmount == resource.data.pledgedAmount
                    && request.resource.data.backersCount == resource.data.backersCount;

      allow delete: if isCampaignOwnerFromData(resource.data)
                    && resource.data.status == 'draft';
    }

    match /campaigns/{campaignId}/pledges/{pledgeId} {
      allow read: if isAuthenticated()
                  && (
                    resource.data.backerUid == request.auth.uid
                    || isCampaignOwnerFromData(campaignDoc(campaignId).data)
                  );

      allow create, update, delete: if false;
    }

    match /campaigns/{campaignId}/payment_attempts/{attemptId} {
      allow read: if isAuthenticated()
                  && (
                    resource.data.createdByUid == request.auth.uid
                    || isCampaignOwnerFromData(campaignDoc(campaignId).data)
                  );

      allow create: if isAuthenticated()
                    && request.resource.data.createdByUid == request.auth.uid
                    && request.resource.data.provider == 'paymongo_checkout'
                    && request.resource.data.status == 'created'
                    && request.resource.data.currency == 'PHP'
                    && request.resource.data.amount is int
                    && request.resource.data.amount > 0;

      allow update, delete: if false;
    }
  }
}
